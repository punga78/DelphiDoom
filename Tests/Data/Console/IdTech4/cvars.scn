# scenario of the cvar system, written for the tests (no text of Doom 3)
# flags: BOOL 1, INTEGER 2, FLOAT 4, SYSTEM 8, RENDERER 16, SOUND 32, GUI 64, GAME 128, TOOL 256, USERINFO 512,
# SERVERINFO 1024, NETWORKSYNC 2048, STATIC 4096, CHEAT 8192, NOCHEAT 16384, INIT 32768, ROM 65536, ARCHIVE 131072
reg	t_string	hello	128	a plain string
reg	t_bool	1	1	a boolean
reg	t_int	5	2	an integer
reg	t_float	0.5	4	a float
regr	t_irange	5	2	integer in range	0	10
regr	t_frange	0.5	4	float in range	-1	1
regr	t_negrange	50	2	integer with minimum above maximum	10	-10
regs	t_enum	beta	128	a list of strings	alpha|beta|gamma
reg	t_arch	3	131074	archived integer
reg	t_rom	fixed	65536	read only
reg	t_init	boot	32768	write protected
reg	t_cheat	1	128	a cheat by default
reg	t_nocheat	1	16512	not a cheat
reg	t_sync	0	2048	synced
reg	t_user	x	512	user info
reg	t_srv	y	1024	server info
reg	t_tool	z	256	tool
reg	t_sys	s	8	system
reg	t_rend	r	16	renderer
reg	t_snd	d	32	sound
reg	t_gui	g	64	gui
