spawn classname func_door name d5 size 8\x2064\x20128 angle -1 wait 0 triggerOpened r1 triggerClosed r2
event 38 activate -1
frame 60
spawn classname func_door name d6 size 8\x2064\x20128 angle -1 time 0.5 wait 0.5
event 39 open
