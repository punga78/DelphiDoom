# Doom 3 world harness scenario. Bounds of the entities: the "size" key (x y z: mins -x/2 -y/2 0, maxs x/2 y/2 z), written with \x20
def info_recorder spawnclass idRecorder
def func_door spawnclass idDoor
def func_mover spawnclass idMover
def trigger_multi spawnclass idTrigger_Multi
def trigger_once spawnclass idTrigger_Multi wait -1
def trigger_relay spawnclass idTrigger_Multi wait 0 noTouch 1
def trigger_timer spawnclass idTrigger_Timer
def trigger_count spawnclass idTrigger_Count
def trigger_hurt spawnclass idTrigger_Hurt
def trigger_fade spawnclass idTrigger_Fade
def worldspawn spawnclass idWorldspawn
func openSesame
spawn classname info_recorder name r1
spawn classname info_recorder name r2
spawn classname func_door name d1 size 8\x2064\x20128 angle -1 wait 1 origin 10\x2020\x2030
queue
dump 34
frame 1
queue
event 34 activate -1
dump 34
frame 30
dump 34
frame 90
dump 34
queue
frame 80
dump 34
spawn classname func_door name d2 size 100\x2020\x2020 angle 0 speed 100 wait 0.2
dump 35
event 35 open
frame 5
event 35 close
dump 35
frame 40
dump 35
spawn classname func_door name d3 size 8\x2064\x20128 angle -2 time 1 wait -1
dump 36
