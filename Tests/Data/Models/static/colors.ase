*MATERIAL_LIST {
	*MATERIAL 0 {
		*MAP_DIFFUSE {
			*BITMAP "x.tga"
		}
	}
}
*GEOMOBJECT {
*NODE_TM {
*TM_ROW0 1 0 0
*TM_ROW1 0 1 0
*TM_ROW2 0 0 1
*TM_ROW3 0 0 0
}
*MESH {
*MESH_NUMVERTEX 3
*MESH_NUMFACES 1
*MESH_VERTEX_LIST {
*MESH_VERTEX 0 0 0 0
*MESH_VERTEX 1 1 0 0
*MESH_VERTEX 2 0 1 0
}
*MESH_FACE_LIST {
*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 1
}
*MESH_NUMTVFACES 1
*MESH_NUMTVERTEX 3
*MESH_TVERTLIST {
*MESH_TVERT 0 0 0 0
*MESH_TVERT 1 1 0 0
*MESH_TVERT 2 0 1 0
}
*MESH_TFACELIST {
*MESH_TFACE 0 0 1 2
}
*MESH_NUMCVERTEX 3
*MESH_CVERTLIST {
*MESH_VERTCOL 0 1.0 0.0 0.0
*MESH_VERTCOL 1 0.0 1.0 0.0
*MESH_VERTCOL 2 0.0 0.0 1.0
}
*MESH_NUMCVFACES 1
*MESH_CFACELIST {
*MESH_CFACE 0 0 1 2
}
}
*MATERIAL_REF 0
}
