# Radix 2.0 shareware, E1M1: loads the saved game of e1m1_save.script and goes on to the end of the level.
#   Radix32.exe -warp 1 1 -skill 2 -autoscript e1m1_load.script -radixstate r2.txt
# The lines of -radixstate of the two runs are the same at the tics after the load (energy, power ups, triggers,
# actions, walls).

hold 10
load 0
hold 2

# the secret corridor under the canyon: rapid energy, full shield, full armor
goto -3000 -1400 z 450 fight timeout 1500
goto -3700 -1500 z 430 fight timeout 1500
goto -3700 -1750 z 430 fight timeout 1500
goto -3300 -1760 z 430 fight timeout 900
goto -2600 -1700 z 430 fight timeout 900
goto -1198 -1792 z 400 radius 30 fight timeout 900
heal 95 1500
goto -452 -1834 z 400 radius 30 fight timeout 900
goto 359 -1821 z 400 radius 30 fight timeout 900
goto 900 -1800 z 430 fight timeout 900
hunt 400
heal 95 1500
goto 1400 -1750 z 430 fight timeout 900
hunt 400
heal 95 1500

# the big room with the shields, then north to the door to I
goto 2100 -1650 z 430 fight timeout 1500
hunt 600
heal 95 1500
goto 3400 -1650 z 450 fight timeout 1500
hunt 600
heal 95 1500
goto 3900 -1350 z 450 fight timeout 1500
goto 4350 -900 z 450 fight timeout 1500
goto 4400 -570 z 450 fight timeout 1500
hold 60
goto 5100 -570 z 450 fight timeout 900
hunt 600
heal 95 1500

# H and I: the hall, high over its steps, to the two computers (walls 754 and 605)
goto 6000 -300 z 700 fight timeout 1500
hunt 600
goto 7500 -500 z 700 fight timeout 1500
hunt 600
heal 95 1500
goto 9000 -576 z 700 fight timeout 1500
hunt 600
heal 95 1500
goto 10050 -576 z 700 fight timeout 1500
face 10369 -576
hold 200 fire
goto 10050 -1344 z 700 fight timeout 1500
face 10369 -1344
hold 200 fire
hunt 400

# the mud goes down and the pipe of the exit opens: down into it, to the cells of the trigger 0
goto 11500 -960 z 700 fight timeout 1500
hold 300
climb 180
goto 12300 -960 z 180 timeout 600
goto 12800 -960 z 180 timeout 600

# the debriefing; fire ends it and the second level starts
hold 200
hold 20 fire
hold 300 forward 25
