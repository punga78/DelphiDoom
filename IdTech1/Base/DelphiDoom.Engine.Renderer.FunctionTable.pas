{ TEngineRendererFunctionTable }

class procedure TEngineRendererFunctionTable.Apply(ADetail: Integer);
var
  LCombination: Integer;
begin
  LCombination := 0;
{$IF DEFINED(HEXEN)}
  if usemultithread then
    LCombination := LCombination or $1;
  if diher8bittransparency then
    LCombination := LCombination or $2;
  if useclassicfuzzeffect then
    LCombination := LCombination or $4;
  if LevelUseFog then
    LCombination := LCombination or $8;
{$ELSEIF DEFINED(STRIFE)}
  if usemultithread then
    LCombination := LCombination or $1;
  if diher8bittransparency then
    LCombination := LCombination or $2;
{$ELSE}
  if usemultithread then
    LCombination := LCombination or $1;
  if diher8bittransparency then
    LCombination := LCombination or $2;
  if use32bitfuzzeffect then
    LCombination := LCombination or $4;
{$ENDIF}
  TRendererFunctionRows.Apply(RendererFunctionRows, ADetail, LCombination);
  case ADetail of
    DL_LOWEST: videomode := vm8bit;
    DL_LOW: videomode := vm8bit;
    DL_MEDIUM: videomode := vm8bit;
    DL_NORMAL: videomode := vm32bit;
    DL_HIRES: videomode := vm32bit;
    DL_ULTRARES: videomode := vm32bit;
  end;
end;

end.
