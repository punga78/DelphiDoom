{$I Doom32.inc}

unit gl_render;

interface

uses
  Windows,
  d_delphi,
  dglOpenGL,
  d_player,
  gl_defs,
  gl_types,
  r_defs,
  r_visplanes,
  m_fixed,
  DelphiDoom.DynLights.Intf,
  DelphiDoom.GlLevel.Types,
  DelphiDoom.GlLevel.Intf,
  DelphiDoom.GlScene.Types,
  DelphiDoom.GlScene.DrawList,
  DelphiDoom.Engine.GlScene.Types,
  DelphiDoom.Engine.GlScene.FlatCollector,
  DelphiDoom.Engine.GlScene.WallCollector,
  DelphiDoom.Engine.GlScene.WallPainter,
  DelphiDoom.Engine.GlScene.FlatPainter,
  DelphiDoom.Engine.GlScene.SpritePainter,
  DelphiDoom.Engine.GlScene.LightSorter,
  DelphiDoom.Engine.GlScene.LightPainter,
  DelphiDoom.Engine.GlScene.SceneDrawer,
  DelphiDoom.Engine.GlScene.SpriteCollector,
  DelphiDoom.Engine.GlInitializer,
  DelphiDoom.Engine.GlScene.Frame,
  DelphiDoom.Engine.GlLevel.Preprocessor;

//==============================================================================
//
// gld_SceneItemSizes
//
// The sizes of the records of a wall, a flat and a sprite of gl_render: the composition
// root creates the draw list (IdTech1\GlScene) for them
//
//==============================================================================
function gld_SceneItemSizes: TGlSceneItemSizes;

//==============================================================================
//
// gld_ConfigureDrawList
//
// The walls, flats and sprites of a frame (IdTech1\GlScene): the composition root gives the
// list here and gl_render owns it from then on. Without it the level stops with I_Error
//
//==============================================================================
procedure gld_ConfigureDrawList(const ADrawList: TGlSceneDrawList);

//==============================================================================
//
// gld_SceneDrawList
//
// The draw list given with gld_ConfigureDrawList: the composition root gives it to the
// classes that collect the scene
//
//==============================================================================
function gld_SceneDrawList: TGlSceneDrawList;

//==============================================================================
//
// gld_LightTable
//
// The light table of the renderer (gamma, light level), for the classes that collect the scene
//
//==============================================================================
function gld_LightTable: PGlSceneLightTable;

//==============================================================================
//
// gld_ConfigureFlatCollector
//
// The class that collects the flats of a frame (gld_AddPlane): gl_render owns it from then on.
// Without it the level stops with I_Error
//
//==============================================================================
procedure gld_ConfigureFlatCollector(const ACollector: TEngineGlSceneFlatCollector);

//==============================================================================
//
// gld_FlatCollector
//
// The collector given with gld_ConfigureFlatCollector: the walls give it the planes that fill
// the gaps of the missing textures
//
//==============================================================================
function gld_FlatCollector: TEngineGlSceneFlatCollector;

//==============================================================================
//
// gld_ConfigureWallCollector
//
// The class that collects the walls of a frame (gld_AddWall): gl_render owns it from then on.
// Without it the level stops with I_Error
//
//==============================================================================
procedure gld_ConfigureWallCollector(const ACollector: TEngineGlSceneWallCollector);

//==============================================================================
//
// gld_ConfigureWallPainter
//
//==============================================================================
procedure gld_ConfigureWallPainter(const APainter: TEngineGlSceneWallPainter);

//==============================================================================
//
// gld_ConfigureFlatPainter
//
//==============================================================================
procedure gld_ConfigureFlatPainter(const APainter: TEngineGlSceneFlatPainter);

//==============================================================================
//
// gld_ConfigureSpritePainter
//
//==============================================================================
procedure gld_ConfigureSpritePainter(const APainter: TEngineGlSceneSpritePainter);

//==============================================================================
//
// gld_ConfigureSceneDrawer
//
//==============================================================================
procedure gld_ConfigureSceneDrawer(const ADrawer: TEngineGlSceneDrawer);

//==============================================================================
//
// gld_ConfigureLightSorter
//
//==============================================================================
procedure gld_ConfigureLightSorter(const ASorter: TEngineGlSceneLightSorter);

//==============================================================================
//
// gld_ConfigureLightPainter
//
//==============================================================================
procedure gld_ConfigureLightPainter(const APainter: TEngineGlSceneLightPainter);

//==============================================================================
//
// gld_ConfigureInitializer
//
//==============================================================================
procedure gld_ConfigureInitializer(const AInitializer: TEngineGlInitializer);

//==============================================================================
//
// gld_ConfigureLevelPreprocessor
//
// The class that prepares the renderer for a loaded level (gld_PreprocessLevel): gl_render owns it from then on.
// Without it the level stops with I_Error
//
//==============================================================================
procedure gld_ConfigureLevelPreprocessor(const APreprocessor: TEngineGlLevelPreprocessor);

//==============================================================================
//
// gld_ConfigureSceneFrame
//
//==============================================================================
procedure gld_ConfigureSceneFrame(const AFrame: TEngineGlSceneFrame);

//==============================================================================
//
// gld_CalcLightLevel
//
//==============================================================================
function gld_CalcLightLevel(lightlevel: integer): float;

//==============================================================================
//
// gld_StaticLightAlpha
//
//==============================================================================
procedure gld_StaticLightAlpha(light: float; alpha: float);

//==============================================================================
//
// gld_ConfigureSpriteCollector
//
// The class that collects the sprites of a frame (gld_AddSprite): gl_render owns it from then on.
// Without it the level stops with I_Error
//
//==============================================================================
procedure gld_ConfigureSpriteCollector(const ACollector: TEngineGlSceneSpriteCollector);

//==============================================================================
//
// gld_ConfigureFlatCarver
//
// The carver of the flats (IdTech1\GlLevel): gld_PreprocessSectors uses it; the composition
// root calls this, without it the level stops with I_Error
//
//==============================================================================
procedure gld_ConfigureFlatCarver(const ACarver: IGlFlatCarver);

//==============================================================================
//
// gld_ConfigureSectorPreprocessor
//
// The checks on the sectors (IdTech1\GlLevel): gld_PreprocessSectors uses them; the composition
// root calls this, without it the level stops with I_Error
//
//==============================================================================
procedure gld_ConfigureSectorPreprocessor(const APreprocessor: IGlSectorPreprocessor);

//==============================================================================
//
// gld_AddFlatLoop
//
// A polygon of a flat from the carver (called by the sink of the engine)
//
//==============================================================================
procedure gld_AddFlatLoop(const sectorid: integer; const points: PGlFixedPoint; const count: integer);

//==============================================================================
//
// gld_ConfigureDynamicLights
//
// The lights of the level (IdTech1\DynLights): gld_Init reads the lumps, R_ShutDownOpenGL
// forgets them, the sprites read their records. The composition root calls it; without it
// gld_Init stops with I_Error
//
//==============================================================================
procedure gld_ConfigureDynamicLights(const ACache: IDynLightRenderCache);

var
  extra_red: float = 0.0;
  extra_green: float = 0.0;
  extra_blue: float = 0.0;
  extra_alpha: float = 0.0;

  // the vertexes and texture coordinates of the flats, and the list of the loops of all the sectors:
  // filled when the level is loaded, read by the painters of the scene
  gld_vertexes: PGLVertexArray = nil;
  gld_texcoords: PGLTexcoordArray = nil;
  sectorloops: PGLSectorArray = nil;

//==============================================================================
//
// gld_DrawBackground
//
//==============================================================================
procedure gld_DrawBackground(const name: string);

//==============================================================================
//
// gld_DrawBackgroundFrame
//
//==============================================================================
procedure gld_DrawBackgroundFrame;

//==============================================================================
//
// gld_Finish
//
//==============================================================================
procedure gld_Finish;

//==============================================================================
//
// gld_AddSprite
//
//==============================================================================
procedure gld_AddSprite(vspr: Pvissprite_t);

//==============================================================================
//
// gld_AddWall
//
//==============================================================================
procedure gld_AddWall(seg: Pseg_t; const ispolyobj: boolean = false; const ssec: Psector_t = nil);

//==============================================================================
//
// gld_StartDrawScene
//
//==============================================================================
procedure gld_StartDrawScene;

//==============================================================================
//
// gld_DrawScene
//
//==============================================================================
procedure gld_DrawScene(player: Pplayer_t);

//==============================================================================
//
// gld_EndDrawScene
//
//==============================================================================
procedure gld_EndDrawScene;

//==============================================================================
//
// gld_AddPlane
//
//==============================================================================
procedure gld_AddPlane(subsectornum: integer; floor, ceiling: Pvisplane_t);

//==============================================================================
//
// gld_PreprocessLevel
//
//==============================================================================
procedure gld_PreprocessLevel;

//==============================================================================
//
// gld_DrawWeapon
//
//==============================================================================
procedure gld_DrawWeapon(weaponlump: integer; vis: Pvissprite_t; lightlevel: integer);

//==============================================================================
//
// gld_Init
//
//==============================================================================
procedure gld_Init(width, height: integer);

//==============================================================================
//
// gld_SetPalette
//
//==============================================================================
procedure gld_SetPalette(palette: integer);

//==============================================================================
//
// gld_DrawNumPatch
//
//==============================================================================
procedure gld_DrawNumPatch(x, y: integer; lump: integer; cm: integer; flags: integer;
  const zoomx: float = 1.0; const zoomy: float = 1.0);

//==============================================================================
//
// gld_Enable2D
//
//==============================================================================
procedure gld_Enable2D;

//==============================================================================
//
// gld_Disable2D
//
//==============================================================================
procedure gld_Disable2D;

//==============================================================================
//
// gld_StaticLight
//
//==============================================================================
procedure gld_StaticLight(light: float);

//==============================================================================
//
// gld_CleanMemory
//
//==============================================================================
procedure gld_CleanMemory;

//==============================================================================
//
// R_ShutDownOpenGL
//
//==============================================================================
procedure R_ShutDownOpenGL;

//==============================================================================
//
// gld_DrawLine
//
//==============================================================================

