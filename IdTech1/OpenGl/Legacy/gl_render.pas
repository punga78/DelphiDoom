//==============================================================================
//
// gld_PreprocessLevel
//
//==============================================================================
procedure gld_PreprocessLevel;
begin
  if gld_drawlist = nil then
    I_Error('gld_PreprocessLevel(): the draw list is not configured (ComposeEngine was not called)');
  if gld_flats = nil then
    I_Error('gld_PreprocessLevel(): the flat collector is not configured (ComposeEngine was not called)');
  if gld_walls = nil then
    I_Error('gld_PreprocessLevel(): the wall collector is not configured (ComposeEngine was not called)');
  if gld_sprites = nil then
    I_Error('gld_PreprocessLevel(): the sprite collector is not configured (ComposeEngine was not called)');
  if gld_wallpainter = nil then
    I_Error('gld_PreprocessLevel(): the wall painter is not configured (ComposeEngine was not called)');
  if gld_flatpainter = nil then
    I_Error('gld_PreprocessLevel(): the flat painter is not configured (ComposeEngine was not called)');
  if gld_spritepainter = nil then
    I_Error('gld_PreprocessLevel(): the sprite painter is not configured (ComposeEngine was not called)');
  if gld_lightsorter = nil then
    I_Error('gld_PreprocessLevel(): the light sorter is not configured (ComposeEngine was not called)');
  if gld_lightpainter = nil then
    I_Error('gld_PreprocessLevel(): the light painter is not configured (ComposeEngine was not called)');
  if gld_scenedrawer = nil then
    I_Error('gld_PreprocessLevel(): the scene drawer is not configured (ComposeEngine was not called)');
  if gld_sceneframe = nil then
    I_Error('gld_PreprocessLevel(): the scene frame is not configured (ComposeEngine was not called)');

  if gld_levelpreprocessor = nil then
    I_Error('gld_PreprocessLevel(): the level preprocessor is not configured (ComposeEngine was not called)');

  gld_levelpreprocessor.Preprocess(gld_flatcarver, gld_sectorpreprocessor);
end;

//==============================================================================
//
// gld_FreeSectorLists
//
//==============================================================================
procedure gld_FreeSectorLists;
var
  i: integer;
begin
  for i := 0 to numsectors - 1 do
    if (sectorloops[i].list <> 0) and (sectorloops[i].list <> GL_BAD_LIST) then
      glDeleteLists(sectorloops[i].list, 1);
end;

//==============================================================================
//
// gld_CleanMemory
//
//==============================================================================
procedure gld_CleanMemory;
begin
  gld_FreeSectorLists;
  gld_CleanTextures;
  gld_CleanPatchTextures;
  gld_CleanModelTextures;
end;

//==============================================================================
//
// R_ShutDownOpenGL
//
//==============================================================================
procedure R_ShutDownOpenGL;
begin
  if GL_Initialized then
  begin
    gld_SkyDone;
    if gl_dynlights <> nil then
      gl_dynlights.Clear;
    TRendererDynLights.R_FreeDynamicLightItems;
    gld_DynamicShadowsDone;
    gld_ModelsDone;
    gld_VoxelsDone;
    gld_LightmapDone;
    gld_ClipperDone;
    gld_AmbientDone;
    gld_ShutDownAutomap;
  end;
end;

initialization

finalization
  gld_ConfigureSceneFrame(nil);
  gld_ConfigureLevelPreprocessor(nil);
  gld_ConfigureInitializer(nil);
  // the collectors use the draw list: they go first
  gld_ConfigureSpriteCollector(nil);
  gld_ConfigureSceneDrawer(nil);
  gld_ConfigureLightPainter(nil);
  gld_ConfigureLightSorter(nil);
  gld_ConfigureSpritePainter(nil);
  gld_ConfigureFlatPainter(nil);
  gld_ConfigureWallPainter(nil);
  gld_ConfigureWallCollector(nil);
  gld_ConfigureFlatCollector(nil);
  gld_ConfigureDrawList(nil);

end.
