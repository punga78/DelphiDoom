  last_palette: integer = 0;

//==============================================================================
//
// gld_SetPalette
//
//==============================================================================
procedure gld_SetPalette(palette: integer);
var
  playpal: PByteArray;
  plpal: PByteArray;
  pal: array[0..GL_SHARED_PALETTE_BYTES - 1] of byte;
  tint: TGlScenePaletteTint;
begin
  extra_red := 0.0;
  extra_green := 0.0;
  extra_blue := 0.0;
  extra_alpha := 0.0;
  if palette < 0 then
    palette := last_palette;
  last_palette := palette;
  if gl_shared_texture_palette then
  begin

    playpal := V_ReadPalette(PU_STATIC);
    plpal := @playpal[768];
    TGlSceneSharedPalette.Build(System.PByte(plpal), System.PByte(fixedcolormap), transparent_pal_index,
      System.PByte(@pal));

    Z_ChangeTag(playpal, PU_CACHE);
    gld_ColorTableEXT(GL_SHARED_TEXTURE_PALETTE_EXT, GL_RGBA, 256, GL_RGBA, GL_UNSIGNED_BYTE, @pal);
  end
  else
  begin
    tint := TGlScenePaletteTints.Compute(palette, {$IFDEF HEXEN}True{$ELSE}False{$ENDIF});
    extra_red := tint.Red;
    extra_green := tint.Green;
    extra_blue := tint.Blue;
    extra_alpha := tint.Alpha;
  end;
end;

