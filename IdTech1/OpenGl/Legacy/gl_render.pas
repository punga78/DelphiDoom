//==============================================================================
//
// gld_CalcLightLevel
//
//==============================================================================
function gld_CalcLightLevel(lightlevel: integer): float;
begin
  result := TGlSceneLight.Level(@gl_lighttable, usegamma, lightlevel);
end;

//==============================================================================
//
// gld_StaticLightAlpha
//
//==============================================================================
procedure gld_StaticLightAlpha(light: float; alpha: float);
begin
  if TGameSession.Players[displayplayer].fixedcolormap <> 0 then
    glColor4f(1.0, 1.0, 1.0, alpha)
  else
    glColor4f(light, light, light, alpha);
end;

//==============================================================================
//
// gld_StaticLight
//
//==============================================================================
procedure gld_StaticLight(light: float);
begin
  if TGameSession.Players[displayplayer].fixedcolormap <> 0 then
    glColor4f(1.0, 1.0, 1.0, 1.0)
  else
    glColor4f(light, light, light, 1.0);
end;

//==============================================================================
//
// gld_Init
//
//==============================================================================
procedure gld_Init(width, height: integer);
begin
  if gld_initializer = nil then
    I_Error('gld_Init(): the initializer is not configured (ComposeEngine was not called)');
  gld_initializer.Initialize(width, height, gl_dynlights);
end;

