{  The actors of WADSRC/SPEED/CAR.txt, RACE.txt and CAMERA.txt of the fork     }
{  that the race needs, without the states that drew the numbers of the        }
{  start and the "you win" picture (the race controller does that)             }
{                                                                              }
{******************************************************************************}
unit DelphiDoom.Speed.ActorDefinitions;

interface

uses
  System.SysUtils;

const
  /// <summary>The type of a car of the computer on the map: a place of the starting grid (MT_CAR)</summary>
  SPEED_THING_CAR = 241;
  /// <summary>The type of a camera of the map (MT_CAMERA)</summary>
  SPEED_THING_CAMERA = 242;
  /// <summary>The type of the thing that started the race in the fork (MT_RACESTART)</summary>
  SPEED_THING_RACE_START = 500;
  /// <summary>The name of the actor of the cars in ACTORDEF</summary>
  SPEED_CAR_ACTOR = 'SpeedCar';

type
  /// <summary>Writes the ACTORDEF lump that the converter of SPEEDH.JCL adds to the WAD</summary>
  TSpeedActorDefinitions = class
  public
    /// <summary>
    ///   The text of the lump. The car has one Spawn state for each car of the game, in the order of the
    ///   table of the cars, so that the state spawnstate + car number is the picture of that car
    /// </summary>
    /// <param name="ACarSprites">
    ///   The name (four characters) of the sprite of each car, or an empty array when the cars have no
    ///   sprites yet (they are invisible)
    /// </param>
    /// <exception cref="EArgumentException">The array has neither zero nor 40 names, or a name is not four characters</exception>
    class function Build(const ACarSprites: TArray<string>): string; static;
  end;

implementation

uses
  DelphiDoom.Racing.Types;

resourcestring
  SSpeedActorDefinitionsCarCount = 'The cars have %d sprite names instead of %d';
  SSpeedActorDefinitionsSpriteName = 'The sprite name "%s" is not four characters';

const
  NEW_LINE = #13#10;

{ TSpeedActorDefinitions }

class function TSpeedActorDefinitions.Build(const ACarSprites: TArray<string>): string;
var
  LBuilder: TStringBuilder;
  LIndex: Integer;
  LSprite: string;
begin
  if (Length(ACarSprites) <> 0) and (Length(ACarSprites) <> RACING_CAR_COUNT) then
    raise EArgumentException.CreateFmt(SSpeedActorDefinitionsCarCount, [Length(ACarSprites), RACING_CAR_COUNT]);
  LBuilder := TStringBuilder.Create;
  try
    LBuilder.Append('// The actors of Speed Haste (generated by Libs\Speed, TSpeedActorDefinitions)').Append(NEW_LINE);
    LBuilder.Append('ACTOR ').Append(SPEED_CAR_ACTOR).Append(' ').Append(SPEED_THING_CAR).Append(NEW_LINE);
    LBuilder.Append('{').Append(NEW_LINE);
    LBuilder.Append('  Radius 16').Append(NEW_LINE);
    LBuilder.Append('  Height 32').Append(NEW_LINE);
    LBuilder.Append('  Health 100000').Append(NEW_LINE);
    LBuilder.Append('  Mass 1000').Append(NEW_LINE);
    if Length(ACarSprites) > 0 then
      // the pictures are drawn at two pixels for each map unit
      LBuilder.Append('  Scale 0.5').Append(NEW_LINE);
    LBuilder.Append('  States').Append(NEW_LINE);
    LBuilder.Append('  {').Append(NEW_LINE);
    LBuilder.Append('  Spawn:').Append(NEW_LINE);
    for LIndex := 0 to RACING_CAR_COUNT - 1 do
    begin
      if (Length(ACarSprites) = 0) or (ACarSprites[LIndex] = '') then
        LSprite := 'TNT1'
      else
      begin
        LSprite := ACarSprites[LIndex];
        if Length(LSprite) <> 4 then
          raise EArgumentException.CreateFmt(SSpeedActorDefinitionsSpriteName, [LSprite]);
      end;
      LBuilder.Append('    ').Append(LSprite).Append(' A -1').Append(NEW_LINE);
    end;
    LBuilder.Append('    Stop').Append(NEW_LINE);
    LBuilder.Append('  }').Append(NEW_LINE);
    LBuilder.Append('}').Append(NEW_LINE);

    LBuilder.Append('ACTOR SpeedRaceStart ').Append(SPEED_THING_RACE_START).Append(NEW_LINE);
    LBuilder.Append('{').Append(NEW_LINE);
    LBuilder.Append('  Radius 1').Append(NEW_LINE);
    LBuilder.Append('  Height 1').Append(NEW_LINE);
    LBuilder.Append('  +NOBLOCKMAP').Append(NEW_LINE);
    LBuilder.Append('  +DONTDRAW').Append(NEW_LINE);
    LBuilder.Append('  States').Append(NEW_LINE);
    LBuilder.Append('  {').Append(NEW_LINE);
    LBuilder.Append('  Spawn:').Append(NEW_LINE);
    LBuilder.Append('    TNT1 A -1').Append(NEW_LINE);
    LBuilder.Append('    Stop').Append(NEW_LINE);
    LBuilder.Append('  }').Append(NEW_LINE);
    LBuilder.Append('}').Append(NEW_LINE);

    LBuilder.Append('ACTOR SpeedCamera ').Append(SPEED_THING_CAMERA).Append(NEW_LINE);
    LBuilder.Append('{').Append(NEW_LINE);
    LBuilder.Append('  Radius 1').Append(NEW_LINE);
    LBuilder.Append('  Height 1').Append(NEW_LINE);
    LBuilder.Append('  +NOBLOCKMAP').Append(NEW_LINE);
    LBuilder.Append('  +DONTDRAW').Append(NEW_LINE);
    LBuilder.Append('  States').Append(NEW_LINE);
    LBuilder.Append('  {').Append(NEW_LINE);
    LBuilder.Append('  Spawn:').Append(NEW_LINE);
    LBuilder.Append('    TNT1 A -1').Append(NEW_LINE);
    LBuilder.Append('    Stop').Append(NEW_LINE);
    LBuilder.Append('  }').Append(NEW_LINE);
    LBuilder.Append('}').Append(NEW_LINE);
    Result := LBuilder.ToString;
  finally
    LBuilder.Free;
  end;
end;

end.
