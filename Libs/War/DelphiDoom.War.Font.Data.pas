function WarDefaultFontData(AFont: Integer): TWarFontData;
begin
  case AFont of
    0:
      begin
        Result.SpriteWidth := 512;
        Result.SpriteHeight := 512;
        Result.LineHeight := 48;
        Result.Advance := 8;
        Result.Glyphs := FONT0_GLYPHS;
      end;
    1:
      begin
        Result.SpriteWidth := 512;
        Result.SpriteHeight := 768;
        Result.LineHeight := 80;
        Result.Advance := 8;
        Result.Glyphs := FONT1_GLYPHS;
      end;
  else
    Result := Default(TWarFontData);
  end;
end;

