<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{7F2B9C41-5D83-4A6E-B170-3E8A1D95C2F6}</ProjectGuid>
        <MainSource>DDScript.dpr</MainSource>
        <ProjectVersion>19.5</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>3</TargetedPlatforms>
        <AppType>Library</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_Define>$(DCC_Define)</DCC_Define>
        <DCC_UnitSearchPath>.;Shim;..\PascalScript;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>Shim;.;..\PascalScript;$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_ResourcePath>..\PascalScript;$(DCC_ResourcePath)</DCC_ResourcePath>
        <DCC_ObjPath>..\PascalScript;$(DCC_ObjPath)</DCC_ObjPath>
        <DCC_ExeOutput>..\..\bin\Libs</DCC_ExeOutput>
        <DCC_DcuOutput>..\..\dcu\Libs\DDScript\$(Config)</DCC_DcuOutput>
        <DCC_UnitAlias>WinTypes=Windows;WinProcs=Windows;$(DCC_UnitAlias)</DCC_UnitAlias>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;System.Win;Vcl;Vcl.Imaging;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
        <DCC_ImageBase>00500000</DCC_ImageBase>
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_SymbolPlatform>false</DCC_SymbolPlatform>
        <DCC_Platform>x86</DCC_Platform>
        <DCC_MapFile>3</DCC_MapFile>
        <DCC_AdditionalSwitches>-TX.dll $(DCC_AdditionalSwitches)</DCC_AdditionalSwitches>
        <SanitizedProjectName>DDScript</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!='' And '$(Platform)'=='Win64'">
        <DCC_Platform>x64</DCC_Platform>
        <DCC_ExeOutput>..\..\bin\Win64\Libs</DCC_ExeOutput>
        <DCC_DcuOutput>..\..\dcu\Win64\Libs\DDScript\$(Config)</DCC_DcuOutput>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug'">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release'">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
