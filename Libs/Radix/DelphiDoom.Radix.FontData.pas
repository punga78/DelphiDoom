function HexToBytes(const AHex: string): TBytes;
var
  LIndex: Integer;
begin
  SetLength(Result, Length(AHex) div 2);
  for LIndex := 0 to High(Result) do
    Result[LIndex] := StrToInt('$' + Copy(AHex, LIndex * 2 + 1, 2));
end;

{ TRadixFontData }

class function TRadixFontData.DosFont: TBytes;
begin
  Result := HexToBytes(DosFontHex);
end;

class function TRadixFontData.SmallDosFont: TBytes;
begin
  Result := HexToBytes(SmallDosFontHex);
end;

class function TRadixFontData.BigFont: TBytes;
begin
  Result := HexToBytes(BigFontHex);
end;

