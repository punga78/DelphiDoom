{$I Doom32.inc}

// JVAL: Needed for model definition

unit sc_states;

interface

uses
  p_mobj_h,
  sc_tokens,
  DelphiDoom.Engine.Info.Intf;

var
  statenames: TTokenList;
  // the DECORATE lumps are read as ACTORDEF (an option of the .ini and of the menu; it was in sc_actordef)
  decorate_as_actordef: boolean = true;

//==============================================================================
//
// SC_ConfigureStateNames
//
// What finds the state that a script names for an actor (the rules are in
// Libs\Info\DelphiDoom.Info.StateNames): ComposeEngine gives it
//
//==============================================================================
procedure SC_ConfigureStateNames(const AResolver: IEngineStateNames);

//==============================================================================
//
// SC_ParseStatedefLump
//
//==============================================================================
procedure SC_ParseStatedefLump;

//==============================================================================
//
// SC_DefaultStatedefLump
//
//==============================================================================
procedure SC_DefaultStatedefLump;

//==============================================================================
//
// P_GetStateFromName
//
//==============================================================================
function P_GetStateFromName(const actor: Pmobj_t; const s1: string): integer;

//==============================================================================
//
// P_GetStateFromNameWithOffsetCheck
//
//==============================================================================
function P_GetStateFromNameWithOffsetCheck(const actor: Pmobj_t; const s1: string): integer;

//==============================================================================
//
// SC_FillStateNames
//
//==============================================================================
procedure SC_FillStateNames;

implementation

uses
  TypInfo,
  d_delphi,
  i_system,
  info_h,
  info,
  DelphiDoom.Scanner.Scanner,
  DelphiDoom.Engine.Scanner.Log,
  w_wad;

const
  STATEDEFLUMPNAME = 'STATEDEF';

var
  default_states_added: boolean = false;
  // given by ComposeEngine (SC_ConfigureStateNames)
  statenames_service: IEngineStateNames = nil;

//==============================================================================
//
// SC_ConfigureStateNames
//
//==============================================================================
procedure SC_ConfigureStateNames(const AResolver: IEngineStateNames);
begin
  statenames_service := AResolver;
end;

//==============================================================================
//
// StateNamesResolver
//
//==============================================================================
function StateNamesResolver: IEngineStateNames;
begin
  if statenames_service = nil then
    I_Error('P_GetStateFromName(): the names of the states are not configured (ComposeEngine was not called)');
  result := statenames_service;
end;

//==============================================================================
//
// SC_DefaultStatedefLump
//
//==============================================================================
procedure SC_DefaultStatedefLump;
var
  st: statenum_t;
begin
  if statenames = nil then
    statenames := TTokenList.Create;
  if not default_states_added then
  begin
    for st := statenum_t(0) to statenum_t(Ord(DO_NUMSTATES) - 1) do
      statenames.Add(strupper(GetENumName(TypeInfo(statenum_t), Ord(st))));
    default_states_added := true;
  end;
end;

//==============================================================================
//
// SC_ParseStatedefLump
//
//==============================================================================
procedure SC_ParseStatedefLump;
var
  i: integer;
  sc: TScriptScanner;
  found: boolean;
  x: integer;

  procedure _newstatealias(const id: integer; const alias: string);
  var
    tid: integer;
  begin
    if statenames.Count > id then
    begin
      if strupper(statenames.Strings[id]) = strupper(alias) then
        exit;
      tid := statenames.IndexOfToken(alias);
      if tid = id then
        exit;
    end;
    statenames.Add(alias);
  end;

begin
  found := false;
  for i := 0 to W_NumLumps - 1 do
    if char8tostring(W_GetNameForNum(i)) = STATEDEFLUMPNAME then
    begin
      found := true;
      sc := TScriptScanner.Create(W_TextLumpNum(i), TEngineScannerLog.Create);
      x := 0;
      while sc.GetString do
      begin
        _newstatealias(x, strupper(sc.AsString));
        inc(x);
      end;
//        statenames.Add(strupper(sc.AsString));
      sc.Free;
      break;
    end;

  // JVAL: Patch for stand alone script compiler
  if not found then
    SC_DefaultStatedefLump;
end;

//==============================================================================
//
// P_GetStateFromName
//
//==============================================================================
function P_GetStateFromName(const actor: Pmobj_t; const s1: string): integer;
begin
  result := StateNamesResolver.StateFromName(actor, s1);
end;

//==============================================================================
//
// P_GetStateFromNameWithOffsetCheck
//
//==============================================================================
function P_GetStateFromNameWithOffsetCheck(const actor: Pmobj_t; const s1: string): integer;
begin
  result := StateNamesResolver.StateFromNameWithOffset(actor, s1);
end;

//==============================================================================
//
// SC_FillStateNames
//
//==============================================================================
procedure SC_FillStateNames;
begin
  while statenames.Count < numstates do
    statenames.Add('S_' + itoa(statenames.Count));
end;

end.

