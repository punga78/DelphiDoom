<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{4C9E1B83-7D25-4A60-B3F1-2E8A5D07C196}</ProjectGuid>
        <MainSource>Xcom32.dpr</MainSource>
        <ProjectVersion>19.5</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Application</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_UnitSearchPath>..\Libs\XcomAudio;..\Libs\Sound;..\Libs\Ogg;..\Libs\Sndfile;..\Libs\Mp3;..\Libs\Mp3\Shim;..\Libs\Mp3\Decoder;..\Libs\Mikmod;..\Libs\Midi;..\Libs\M2m;..\Libs\Logging;..\Libs\Opl;..\Libs\XcomGeoscape;..\Libs\XcomStrategy;..\Libs\XcomBasescape;..\Libs\XcomSave;..\Libs\XcomMod;..\Libs\XcomEngine;..\Libs\XcomUi;..\Libs\XcomMenu;..\Libs\XcomSurface;..\Libs\Yaml;..\Libs\XcomFormats;..\Libs\Video;..\Libs\CommandLine;..\Libs\Png;..\Libs\Zlib;..\Libs\Platform;..\Libs\OpenGl\Binding;.\;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_ExeOutput>..\bin\OpenXcom</DCC_ExeOutput>
        <DCC_DcuOutput>..\dcu\OpenXcom\Xcom32\$(Config)</DCC_DcuOutput>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <DCC_ConsoleTarget>false</DCC_ConsoleTarget>
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_SymbolPlatform>false</DCC_SymbolPlatform>
        <DCC_Platform>x86</DCC_Platform>
        <DCC_MapFile>3</DCC_MapFile>
        <SanitizedProjectName>Xcom32</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug'">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release'">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
