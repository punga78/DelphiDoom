<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{62968330-38E7-5B88-A6B8-41CC9F26CFE1}</ProjectGuid>
        <MainSource>GLDoom32.dpr</MainSource>
        <ProjectVersion>19.5</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Application</AppType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_Define>OPENGL;DOOM;$(DCC_Define)</DCC_Define>
        <DCC_UnitSearchPath>.\Doom;.\Base;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>.\Doom;.\Base;$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_ResourcePath>.\Doom;.\Base;$(DCC_ResourcePath)</DCC_ResourcePath>
        <DCC_ObjPath>.\Libs\Zlib;.\Doom;.\Base;$(DCC_ObjPath)</DCC_ObjPath>
        <DCC_ExeOutput>bin\Doom</DCC_ExeOutput>
        <DCC_DcuOutput>dcu\Doom\GL\$(Config)</DCC_DcuOutput>
        <DCC_UnitAlias>WinTypes=Windows;WinProcs=Windows;$(DCC_UnitAlias)</DCC_UnitAlias>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;System.Win;Vcl;Vcl.Imaging;Vcl.Samples;Vcl.Shell;$(DCC_Namespace)</DCC_Namespace>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <DCC_MinStackSize>16384</DCC_MinStackSize>
        <DCC_MaxStackSize>1048576</DCC_MaxStackSize>
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_UnsafeType>false</DCC_UnsafeType>
        <DCC_UnsafeCode>false</DCC_UnsafeCode>
        <DCC_UnsafeCast>false</DCC_UnsafeCast>
        <DCC_SymbolPlatform>false</DCC_SymbolPlatform>
        <DCC_Platform>x86</DCC_Platform>
        <DCC_MapFile>3</DCC_MapFile>
        <SanitizedProjectName>GLDoom32</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug'">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release'">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
